---
interface Props {
  status: string;
}

const { status } = Astro.props;
const cleanStatus = status ? status.trim() : 'Not Started';

let bg = 'rgba(100, 116, 139, 0.15)';
let color = '#94a3b8';
let border = 'rgba(100, 116, 139, 0.3)';

if (cleanStatus.toLowerCase() === 'in progress') {
  bg = 'rgba(59, 130, 246, 0.15)';
  color = '#60a5fa';
  border = 'rgba(59, 130, 246, 0.3)';
} else if (cleanStatus.toLowerCase() === 'completed') {
  bg = 'rgba(34, 197, 94, 0.15)';
  color = '#4ade80';
  border = 'rgba(34, 197, 94, 0.3)';
}
---

<span style={`display: inline-flex; align-items: center; padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background-color: ${bg}; color: ${color}; border: 1px solid ${border}; line-height: 1.25;`}>
  {cleanStatus}
</span>
